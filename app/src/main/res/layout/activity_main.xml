<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="KPI → TAMMI" android:textStyle="bold" android:textSize="26sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tự tải ZIP • Giải nén • 1 chạm gửi Tammi" android:layout_marginBottom="20dp" />
        <EditText android:id="@+id/edtUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="URL tải file ZIP báo cáo" android:inputType="textUri" />
        <EditText android:id="@+id/edtHour" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Giờ (0-23)" android:inputType="number" android:text="7" />
        <EditText android:id="@+id/edtMinute" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Phút (0-59)" android:inputType="number" android:text="30" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LƯU & BẬT TỰ ĐỘNG" />
        <Button android:id="@+id/btnRun" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CHẠY THỬ NGAY" />
        <Button android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GỬI TAMMI" />
        <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="Chưa cấu hình nguồn báo cáo." />
    </LinearLayout>
</ScrollView>
